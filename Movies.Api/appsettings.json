{
  "Database": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "",
    "Audience": ""
  },
  "ApiKey": "",
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "GlobalQueueLimit": 10,
    "AuthenticatedPermitLimit": 200,
    "AuthenticatedWindowSeconds": 60,
    "AuthenticatedQueueLimit": 20,
    "AdminPermitLimit": 500,
    "AdminWindowSeconds": 60,
    "AdminQueueLimit": 50
  },
  "SecurityHeaders": {
    "EnableStrictTransportSecurity": true,
    "StrictTransportSecurityMaxAge": 31536000,
    "EnableContentSecurityPolicy": true,
    "ContentSecurityPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none';",
    "EnableXContentTypeOptions": true,
    "EnableXFrameOptions": true,
    "XFrameOptions": "DENY",
    "EnableXssProtection": true,
    "EnableReferrerPolicy": true,
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "EnablePermissionsPolicy": true,
    "PermissionsPolicy": "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), speaker=()"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
